{
  "name": "instagram-minimal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Use o Instagram sem Reels, sem vídeos curtos recomendados e sem publicações sugeridas. Extensão local, privada e de código aberto.",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:ext && npm run build:dashboard",
    "build:ext": "node scripts/build-extensions.mjs",
    "build:dashboard": "node scripts/build-userscript.mjs && vite build --config apps/dashboard/vite.config.ts",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build-extensions.mjs && node scripts/build-userscript.mjs && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "package": "node scripts/build-extensions.mjs && node scripts/package.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build:userscript": "node scripts/build-userscript.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/chrome": "^0.3.8",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
